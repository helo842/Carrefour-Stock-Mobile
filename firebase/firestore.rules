rules_version = '2';

// All reads/writes go through the Express API using the Admin SDK, which
// bypasses these rules. Denying client access prevents a leaked Firebase web
// config from becoming a data breach. Keep it this way: never query Firestore
// directly from the mobile app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
