# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
APP_VERSION=1.0.0

# Browsers allowed to call the API (comma-separated). Native apps send no Origin.
CORS_ORIGINS=

# ---- Firebase Admin --------------------------------------------------------
# Project id. Optional when the service account JSON includes project_id.
FIREBASE_PROJECT_ID=carrefour-stock-dev

# Full service account JSON in ONE line. In Cloud Run / GKE leave it empty and
# use the workload identity (Application Default Credentials) instead.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Business rules --------------------------------------------------------
LOW_STOCK_THRESHOLD=10

# ---- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ---- OpenFoodFacts ---------------------------------------------------------
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=CarrefourStockMobile/1.0 (soporte@carrefour.example)
OFF_TIMEOUT_MS=6000
OFF_CACHE_TTL_MS=600000
OFF_SEARCH_CACHE_TTL_MS=300000
